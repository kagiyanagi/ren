---
import WindowCard from "@/components/WindowCard.astro";

// maxlength mirrors the server limits in api/send-message.ts.
const inputClass =
  "bg-white/5 rounded px-3 py-2 text-white placeholder-white/40 focus:outline-none focus:bg-white/10 [&:user-invalid]:ring-2 [&:user-invalid]:ring-red-400 transition-colors [caret-shape:underscore] w-full";
const labelClass = "text-white/70 text-sm";
---

<WindowCard bordered={false}>
  <h3 class="text-xl font-medium text-white mb-4">
    <span class="text-white/70 mr-2">❯</span>
    Get in touch
  </h3>
  <p class="text-white/80 text-sm font-thin mb-6">
    Want to send me a message? Then go ahead!
  </p>
  <form id="contact-form" class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <label for="name" class={labelClass}>Name</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Your name"
        autocomplete="name"
        maxlength="80"
        required
        class={inputClass}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label for="email" class={labelClass}>Email</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="your@email.com"
        autocomplete="email"
        maxlength="254"
        required
        class={inputClass}
      />
    </div>
    <div class="flex flex-col gap-2">
      <label for="message" class={labelClass}>Message</label>
      <textarea
        id="message"
        name="message"
        placeholder="Your message..."
        rows="5"
        maxlength="3500"
        required
        class={`${inputClass} resize-none`}></textarea>
      <span
        id="msg-count"
        class="self-end text-xs text-white/40 tabular-nums"
        aria-live="polite">0 / 3500</span
      >
    </div>
    <button
      type="submit"
      id="send-btn"
      class="bg-white/10 text-white font-medium py-2 px-4 rounded hover:bg-white/20 transition-all ease-in-out"
    >
      Send Message
    </button>
  </form>
  <script>
    const form = document.getElementById("contact-form");
    const nameEl = document.getElementById("name");
    const emailEl = document.getElementById("email");
    const msgEl = document.getElementById("message");
    const sendBtn = document.getElementById("send-btn");
    const countEl = document.getElementById("msg-count");
    const bell = new Audio("/terminal_bell.mp3");
    // Matches the server's per-client window.
    const COOLDOWN_MS = 30_000;
    let cooldownUntil = 0;
    let sending = false;

    function showCooldownNotice() {
      const seconds = Math.ceil((cooldownUntil - Date.now()) / 1000);
      window.showNotification(
        `Please wait ${seconds}s before sending another message.`,
        "warning",
      );
    }

    // Terminal bell on backspace in an empty field.
    [nameEl, emailEl, msgEl].forEach((el) => {
      el.addEventListener("keydown", (event) => {
        if (event.key === "Backspace" && !el.value) bell.play().catch(() => {});
      });
    });

    msgEl.addEventListener("input", () => {
      const n = msgEl.value.length;
      countEl.textContent = `${n} / 3500${n > 3300 ? " — okay, essay mode" : ""}`;
    });

    const focusNextOnEnter = (current, next) => {
      current.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" || event.isComposing) return;
        event.preventDefault();
        next.focus();
      });
    };
    focusNextOnEnter(nameEl, emailEl);
    focusNextOnEnter(emailEl, msgEl);
    msgEl.addEventListener("keydown", (event) => {
      if (
        event.key !== "Enter" ||
        event.isComposing ||
        !(event.ctrlKey || event.metaKey)
      )
        return;
      event.preventDefault();
      form.requestSubmit();
    });

    // Only fires once the browser's built-in validation passes.
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (Date.now() < cooldownUntil) return showCooldownNotice();
      if (sending) return;
      sending = true;
      sendBtn.disabled = true;
      const spin = "|/-\\";
      let frame = 0;
      sendBtn.textContent = "[|] transmitting";
      const spinner = setInterval(() => {
        sendBtn.textContent = `[${spin[++frame % 4]}] transmitting`;
      }, 90);
      try {
        const resp = await fetch("/api/send-message", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            name: nameEl.value,
            email: emailEl.value,
            message: msgEl.value,
          }),
        });
        if (resp.status === 429) {
          const retryAfter = Number(resp.headers.get("Retry-After") || 10);
          cooldownUntil = Date.now() + retryAfter * 1000;
          return showCooldownNotice();
        }
        if (!resp.ok) {
          const json = await resp.json().catch(() => null);
          const detail =
            typeof json?.error === "string" ? json.error : `(${resp.status})`;
          window.showNotification(`Failed to send message: ${detail}`, "error");
          return;
        }
        window.showNotification("Message sent successfully!", "success");
        form.reset();
        countEl.textContent = "0 / 3500";
        cooldownUntil = Date.now() + COOLDOWN_MS;
      } catch (error) {
        console.error("Error sending message:", error);
        window.showNotification(
          "Failed to send message. Please try again.",
          "error",
        );
      } finally {
        clearInterval(spinner);
        sending = false;
        sendBtn.disabled = false;
        sendBtn.textContent = "Send Message";
      }
    });
  </script>
</WindowCard>
