---
type Props = {
  title: string;
  full_screen?: boolean;
  class?: string;
};
const {
  title = "Section",
  full_screen = false,
  class: className = "",
} = Astro.props;
---

<section
  id={title.toLowerCase().replaceAll(" ", "")}
  data-path={title.toLowerCase().replaceAll(" ", "-")}
  class={`${full_screen ? "min-h-[100svh]" : ""} scroll-mt-20 px-4 py-10 w-full !overflow-x-hidden ${className}`}
>
  <div class="w-full grid place-items-center">
    <h2
      class="text-4xl md:text-6xl text-center font-pixel phosphor-text"
      data-decode
      aria-label={title}
    >
      {`<${title} />`}
    </h2>
  </div>
  <div class="w-full mt-10 px-4">
    <slot />
  </div>
</section>

<script>
  import { scramble } from "@/lib/fx";

  // Titles "decode" the first time they scroll into view.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach(({ isIntersecting, target }) => {
        if (!isIntersecting) return;
        io.unobserve(target);
        const el = target as HTMLElement;
        scramble(el, el.textContent!.trim(), 900);
      }),
    { threshold: 0.6 },
  );
  document.querySelectorAll("[data-decode]").forEach((el) => io.observe(el));
</script>
