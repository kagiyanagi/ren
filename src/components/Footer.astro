---
import { GITHUB_REPO } from "@/consts";
const year = new Date().getFullYear();
const link = "text-white/60 hover:text-white hover:underline";
---

<section
  id="footer"
  class="mt-16 mx-auto max-w-5xl px-5 py-6 border-t border-white/10 flex flex-col sm:flex-row gap-3 justify-between items-center text-xs text-white/40"
>
  <p id="my-time"></p>
  <p class="flex flex-wrap justify-center gap-x-3">
    <a
      class={link}
      href={`https://github.com/${GITHUB_REPO}`}
      target="_blank"
      rel="noopener noreferrer">★ star on github</a
    >
    <span>
      theme by <a
        class={link}
        href="https://github.com/ArnavK-09"
        target="_blank"
        rel="noopener noreferrer">@ArnavK-09</a
      >
    </span>
    <a class={link} href="/humans.txt">made by a human</a>
    <span>copyleft &copy; {year}</span>
  </p>
</section>

<script>
  // My local time, and a rough guess at what I'm doing about it.
  const el = document.getElementById("my-time")!;
  const clock = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Kolkata",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  });
  const doing = (h: number) =>
    h < 6
      ? "probably asleep. or debugging."
      : h < 8
        ? "waking up, barely."
        : h < 14
          ? "at school, pretending to pay attention."
          : h < 18
            ? "doing homework (lie)."
            : h < 22
              ? "coding, probably."
              : "should be asleep. isn't.";
  function tick() {
    const now = clock.format(new Date());
    el.textContent = `${now} IST — ${doing(Number(now.slice(0, 2)))}`;
  }
  tick();
  setInterval(tick, 30_000);
</script>
