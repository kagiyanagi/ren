<div
  id="__notification_root"
  aria-live="polite"
  class="fixed bottom-6 inset-x-0 px-4 z-50 pointer-events-none"
>
</div>

<script type="module">
  const root = document.getElementById("__notification_root");
  // systemd-style status tags, because everything here is a terminal.
  const tags = {
    success: ["[  OK  ]", "text-emerald-400"],
    error: ["[FAILED]", "text-rose-400"],
    warning: ["[ WARN ]", "text-amber-300"],
    info: ["[ INFO ]", "text-sky-300"],
  };

  function hide(node) {
    node.classList.add("notify-hide");
    setTimeout(() => node.remove(), 300);
  }

  window.showNotification = function (message, type = "info", ttl = 4000) {
    const el = document.createElement("div");
    el.className =
      "notify-item pointer-events-auto max-w-xl w-full mx-auto bg-black/90 border border-white/70 px-4 py-2 mb-2 text-sm flex items-center gap-3 justify-between";
    el.setAttribute("role", "status");

    const [tag, tone] = tags[type] || tags.info;
    const label = document.createElement("span");
    label.textContent = tag;
    label.className = `${tone} mr-3 whitespace-pre`;
    const txt = document.createElement("div");
    txt.append(label, message);
    txt.className = "text-white";

    const close = document.createElement("button");
    close.className = "text-white/80 hover:text-white ml-4";
    close.type = "button";
    close.textContent = "✕";
    close.setAttribute("aria-label", "Dismiss notification");
    close.addEventListener("click", () => hide(el));

    el.append(txt, close);
    root.appendChild(el);
    setTimeout(() => hide(el), ttl);
  };
</script>
