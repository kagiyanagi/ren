---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 - Not Found">
  <section
    class="min-h-[100svh] w-full text-white flex items-center justify-center relative overflow-hidden px-4 sm:px-6"
  >
    <div class="w-full max-w-[640px] text-center space-y-4 sm:space-y-6">
      <h1 class="text-center">
        <span
          class="bg-white text-black px-4 py-1 inline-block text-lg sm:text-xl"
          data-decode
        >
          Error - 404
        </span>
      </h1>
      <p class="text-sm sm:text-base">
        This page fell into the Sea of Dirac. Leliel says sorry.
      </p>
      <p class="text-sm sm:text-base">An error has occurred. To continue:</p>
      <p class="text-sm sm:text-base leading-relaxed">
        * Return to the homepage.<br />
        * Report it via the <a href="/#contactme" class="underline"
          >contact form</a
        > and try later.<br />
        * Or press <kbd class="border border-white/50 px-1">~</kbd> and type
        <code>cd ~</code>, like a real one.
      </p>
      <nav class="text-sm sm:text-base" aria-label="Not found navigation">
        <a
          href="/"
          class="px-2 py-1 hover:bg-white hover:text-black focus-visible:bg-white focus-visible:text-black focus-visible:outline-none"
        >
          index
        </a>
        <span class="mx-1 text-white/70">|</span>
        <a
          href=""
          class="px-2 py-1 hover:bg-white hover:text-black focus-visible:bg-white focus-visible:text-black focus-visible:outline-none"
        >
          refresh
        </a>
      </nav>
    </div>
  </section>
</Layout>

<script>
  import { scramble } from "@/lib/fx";
  const el = document.querySelector<HTMLElement>("[data-decode]")!;
  scramble(el, el.textContent!.trim(), 1200);
</script>
