---
import Hero from "@/components/Hero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import Contact from "@/components/Contact.astro";
import { Image } from "astro:assets";
import VillainImg from "@/assets/villain.png";
import House from "@/assets/house.gif";
import {
  KNOWN_TECH,
  PROJECTS,
  TECH_NOTES,
  GITHUB_REPO,
  GITHUB_USERNAME,
  NAV_LINKS,
  type Project,
} from "@/consts";
import { fetchLatestCommitDate, fetchPinnedProjects } from "@/lib/github";

const projects: readonly Project[] =
  (await fetchPinnedProjects(GITHUB_USERNAME)) ?? PROJECTS;

const commitISO = await fetchLatestCommitDate(GITHUB_REPO);
---

<Layout title="Aman - I go by the username 'kagiyanagi' on the internet">
  <Hero />
  <Section
    title="About me"
    class={"max-w-screen-2xl mx-auto flex flex-col gap-8 items-center"}
  >
    <div
      class="w-full grid place-items-center gap-4 grid-cols-1 sm:grid-cols-2"
    >
      <div class="w-full flex justify-center" data-reveal>
        <div class="ascii-shade flex">
          <Image
            alt="Leliel from Neon Genesis Evangelion. source:(http://anime.en.utf8art.com/arc/evangelion_190.html)"
            src={VillainImg}
            data-tip="the shadow is the real body."
            class="brightness-200 max-w-xs sm:max-w-sm md:max-w-md object-contain invert hover:invert-0 transition-[filter] duration-1000"
          />
        </div>
      </div>

      <div
        class="w-full flex flex-col justify-center text-lg sm:text-xl gap-4 max-w-screen-md"
        data-reveal
      >
        <h3
          class="text-2xl sm:text-4xl opacity-95 mb-4 flex items-center gap-4 flex-col sm:flex-row"
        >
          Hi, I'm Aman <span class="text-xl text-[#CCCCCC]"
            >(A.K.A kagiyanagi/ren/aqua).</span
          >
        </h3>
        <p class="opacity-95">
          I'm a self-taught engineer and passionate tech guy from India,
          currently in high school. My interests span a wide range in Computer
          Science, including:
        </p>
        <p class="opacity-95">
          Web development, IoT, Machine learning, Linux(Arch btw). I'm a big fan
          of anime (<a
            class="underline transition-all"
            href="https://anilist.co/user/kagiyanagi/"
            target="_blank"
            rel="noopener noreferrer">anilist link</a
          >) and music, which both inspire my creativity. Core Android
          development: I love building custom ROMs and kernels. I've archived
          everything on my
          <a
            class="underline transition-all"
            href="https://t.me/rensakashvani"
            target="_blank"
            rel="noopener noreferrer">Telegram channel</a
          >
        </p>
        <p class="opacity-95">
          Right now I'm mostly focused on high school (you know how it is), but
          I'm still highly motivated and committed to continuous learning and
          growth in the tech world.
        </p>
        <p
          id="lastUpdated"
          class="text-zinc-400 text-xl custom-cursor-help"
          data-tip="This data is coming from my GitHub repository's latest commit."
          data-commit={commitISO}
        >
          Last updated: loading…
        </p>
        <p
          class="margin-note flex items-end gap-2 -mt-3 ml-6 rotate-[-3deg]"
          aria-hidden="true"
        >
          <svg viewBox="0 0 70 40" class="w-10 -rotate-[70deg]"
            ><path d="M5 34 C 20 30, 30 20, 34 6 M26 12 L34 4 L40 13"
            ></path></svg
          >
          yes, to the millisecond. i was bored.
        </p>

        <script>
          const el = document.getElementById("lastUpdated");
          const commitISO = el?.dataset?.commit || null;
          const commitTime = commitISO ? new Date(commitISO).getTime() : null;

          function updateSince() {
            if (!el) return;
            if (!commitTime) {
              el.textContent = "Last updated: unknown";
              return;
            }

            const now = Date.now();
            let diff = now - commitTime;

            const ms = diff % 1000;
            diff = Math.floor(diff / 1000);

            const s = diff % 60;
            diff = Math.floor(diff / 60);

            const m = diff % 60;
            diff = Math.floor(diff / 60);

            const h = diff % 24;
            const d = Math.floor(diff / 24);

            el.textContent = `Last updated: ${d}d ${h}h ${m}m ${s}s ${ms}ms ago`;
            requestAnimationFrame(updateSince);
          }

          updateSince();
        </script>
      </div>
    </div>
  </Section>
  <Section title="Technologies i like" full_screen={false}>
    <div class="w-full grid place-items-center mb-12">
      <div class="w-full gap-4 flex flex-wrap max-w-2xl text-lg justify-center">
        {KNOWN_TECH.map((x) => <Breadcrumb title={x} note={TECH_NOTES[x]} />)}
      </div>
      <p class="margin-note mt-8 rotate-2" aria-hidden="true">
        (hover them. each one has a confession.)
      </p>
    </div>
  </Section>
  <Section
    title="My projects"
    class={"max-w-screen-2xl mx-auto items-center mb-12"}
  >
    <p
      class="margin-note -mt-4 mb-6 mx-auto w-fit rotate-[-2deg]"
      aria-hidden="true"
    >
      pinned straight from my github. try closing one. ↓
    </p>
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </Section>
  <Section
    title="Contact me"
    class={"max-w-screen-2xl mx-auto flex flex-col gap-8 items-center"}
  >
    <div
      class="w-full grid place-items-center grid-cols-1 sm:grid-cols-2 gap-12 sm:gap-0"
    >
      <div class="flex flex-col items-center gap-6">
        <div class="ascii-shade flex">
          <Image
            alt="Mushroom Shop, A cozy little shop, run by a certain eccentric shopkeep. source:(https://www.newgrounds.com/art/view/stonestoryrpg/mushroom-shop)"
            src={House}
            data-tip="the shopkeep says hi."
            class="brightness-200 max-w-xs sm:max-w-sm mix-blend-screen"
          />
        </div>
        <p
          class="margin-note hidden sm:flex items-center gap-2 rotate-[-3deg]"
          aria-hidden="true"
        >
          the shopkeep delivers every letter by hand.
          <svg viewBox="0 0 70 40" class="w-12 rotate-12"
            ><path d="M3 30 C 18 8, 40 4, 64 14 M55 6 L65 14 L54 20"
            ></path></svg
          >
        </p>
        <div class="text-sm text-white/60 font-thin tracking-wider">
          <p class="text-white/80">
            <span class="text-white/40">$</span> ls ~/elsewhere
          </p>
          <ul class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
            {
              NAV_LINKS.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-white hover:underline"
                  >
                    {l.title.toLowerCase()}/
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="w-full max-w-xl">
        <Contact />
      </div>
    </div>
  </Section>
</Layout>
